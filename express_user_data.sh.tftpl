#!/bin/bash
# Part 2 user-data: Express frontend instance (port ${express_port}), backend = ${backend_url}
set -euxo pipefail
exec > >(tee /var/log/user-data.log) 2>&1

echo "=== Installing Node.js ==="
dnf install -y nodejs nodejs-npm || dnf install -y nodejs20 nodejs20-npm

echo "=== Deploying Express frontend ==="
mkdir -p /opt/express-frontend
echo '${express_server_b64}' | base64 -d > /opt/express-frontend/server.js
echo '${express_package_b64}' | base64 -d > /opt/express-frontend/package.json
cd /opt/express-frontend
npm install --omit=dev
chown -R ec2-user:ec2-user /opt/express-frontend

cat > /etc/systemd/system/express-frontend.service <<'UNIT'
[Unit]
Description=Express frontend
After=network-online.target
Wants=network-online.target

[Service]
User=ec2-user
WorkingDirectory=/opt/express-frontend
Environment=PORT=${express_port}
Environment=BACKEND_URL=${backend_url}
ExecStart=/usr/bin/node server.js
Restart=always

[Install]
WantedBy=multi-user.target
UNIT

systemctl daemon-reload
systemctl enable --now express-frontend.service

sleep 5
curl -s http://localhost:${express_port}/health || true
echo "=== Done ==="
